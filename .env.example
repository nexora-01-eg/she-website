# SHE — env template. Never commit real secrets.
# Admin import uses server-side Basic auth only (see middleware.ts).
SHE_ADMIN_USER=admin
# Set a long random password in production host env:
SHE_ADMIN_PASS=change-me-in-production
# Strict production guard blocks seed/TODO deploys:
# SHE_PRODUCTION_GUARD=strict
# Asset source dir for mapping script (defaults to D:\BAGS SBS\WEB):
# WEB_ASSETS_DIR=D:\BAGS SBS\WEB

# Future (Phase B): Supabase / DB for orders + Inner Circle
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# Pixel IDs come from data/config.ts, not env.
