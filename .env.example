# SHE — env template. Never commit real secrets.
# Admin import uses server-side Basic auth only (see middleware.ts).
SHE_ADMIN_USER=admin
# Set a long random password in production host env:
SHE_ADMIN_PASS=change-me-in-production
# Strict production guard blocks seed/TODO deploys:
# SHE_PRODUCTION_GUARD=strict
# Asset source dir for mapping script (defaults to D:\BAGS SBS\WEB):
# WEB_ASSETS_DIR=D:\BAGS SBS\WEB

# Supabase (orders, inner circle, import snapshots). Paste from Supabase dashboard → Settings → API.
# NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server only, NEVER prefix with NEXT_PUBLIC_
# Run supabase/schema.sql once in the SQL editor before going live.
# Without these keys: local dev falls back to data/orders/*.json; hosted builds refuse order writes (503).

# Future: Pixel IDs come from data/config.ts, not env.
